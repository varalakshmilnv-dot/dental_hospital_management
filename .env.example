# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side administrator passcode.
# If left empty, the first administrator can claim and set a password via the in-app Admin Setup screen.
ADMIN_PASSCODE=

# CLINIC_ADMIN_EMAIL: Email address to receive clinic appointment notifications
CLINIC_ADMIN_EMAIL=

# RESEND_API_KEY: Optional Resend API key for automated patient acknowledgement & admin alert emails
RESEND_API_KEY=
EMAIL_FROM=

# WHATSAPP_ACCESS_TOKEN & WHATSAPP_PHONE_NUMBER_ID: Official Meta WhatsApp Business Platform credentials (optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_PHONE=

# SUPABASE BACKEND (Project ID: jeyrykacwcahfpelifcp | Region: ap-south-1)
# Keep SUPABASE_SERVICE_ROLE_KEY strictly on the server (never prefix with VITE_).
SUPABASE_PROJECT_ID=jeyrykacwcahfpelifcp
SUPABASE_REGION=ap-south-1
SUPABASE_URL=https://jeyrykacwcahfpelifcp.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

